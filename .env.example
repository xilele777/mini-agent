# 复制为需要操作的项目目录中的 .env，填写自己的模型配置。
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://your-api-endpoint.example/v1
OPENAI_MODEL=your-model-name

# Windows 必填，取消注释并按实际 Git for Windows 安装位置修改。
# MINI_AGENT_SHELL=C:/Program Files/Git/bin/bash.exe
# Linux/macOS 默认 /bin/sh；不要填写 PowerShell/cmd.exe。

# 可选项及默认值（完整说明见 README.md）
# MINI_AGENT_REQUEST_TIMEOUT_MS=120000
# MINI_AGENT_COMMAND_TIMEOUT_MS=30000
# MINI_AGENT_MAX_ITERATIONS=10
# MINI_AGENT_SUBAGENT_MAX_ITERATIONS=6
# MINI_AGENT_MAX_REQUESTS=24
# MINI_AGENT_MAX_TOTAL_TOKENS=200000
# MINI_AGENT_TURN_TIMEOUT_MS=600000
# MINI_AGENT_MAX_RETRIES=2
# MINI_AGENT_RETRY_BASE_MS=500
# MINI_AGENT_CONTEXT_WINDOW=32768
# MINI_AGENT_OUTPUT_RESERVE=4096
# MINI_AGENT_CONTEXT_MARGIN=1024
# MINI_AGENT_OUTPUT_TOKEN_PARAM=max_completion_tokens
# MINI_AGENT_MAX_READ_MB=5
