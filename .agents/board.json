{
  "name": "mini-agent",
  "map": {
    "title": "运行流程",
    "defaultNode": "model",
    "flow": ["input", "model", "tools", "result"],
    "loop": { "from": "result", "to": "model", "label": "继续调用模型" },
    "supports": [
      { "id": "context", "target": "model", "label": "提供对话历史" },
      { "id": "todos", "target": "tools", "label": "工具按需读写" },
      { "id": "delegation", "target": "tools", "label": "同步委派只读调查" }
    ],
    "branches": {
      "from": "tools",
      "title": "控制工具",
      "items": [
        { "id": "ask", "returnsTo": "result", "label": "回答回填后，继续本轮" },
        { "id": "finish", "returnsTo": "input", "label": "结束本轮，等待新指令" },
        { "id": "pause", "returnsTo": "input", "label": "结束本轮，等待新指令" }
      ]
    },
    "nodes": [
      {
        "id": "input", "title": "用户输入", "caption": "新指令开启一轮",
        "behavior": ["先裁剪旧历史，再把新输入加入对话，标记为真实用户轮。", "一轮完成或暂停后，终端继续等待你的下一条指令。"],
        "boundary": "执行中的提问和系统内部的继续提示，仍属于原来这一轮。",
        "notes": ["implemented/architecture/2026-09-11-user-turn-boundaries.md", "implemented/architecture/2026-09-02-shared-terminal-input.md"],
        "sources": [{ "label": "agent.ts · main", "path": "../src/agent.ts" }, { "label": "ui.ts · ask", "path": "../src/ui.ts" }]
      },
      {
        "id": "model", "title": "模型调用", "caption": "读取上下文，选择动作",
        "behavior": ["把对话历史和工具说明一起发给模型，逐片显示文本并将 Function Calling 片段组装成完整消息。", "只有文字回复时，追加继续提示，引导它执行、提问、完成或暂停。"],
        "boundary": "模型可能判断错误。每个真实用户轮最多请求十次模型，重复调用另有守卫。",
        "notes": ["implemented/architecture/2026-08-31-native-function-calling.md", "implemented/feature/2026-09-13-streamed-model-response.md", "implemented/feature/2026-09-05-loop-guard-and-request-budget.md", "implemented/simplification/2026-08-31-remove-handwritten-react-parser.md"],
        "sources": [{ "label": "turn.ts · runTurn", "path": "../src/turn.ts" }, { "label": "stream.ts · 流组装", "path": "../src/stream.ts" }, { "label": "llm.ts · 模型连接", "path": "../src/llm.ts" }]
      },
      {
        "id": "tools", "title": "工具执行", "caption": "校验 → 按需批准 → 执行",
        "behavior": ["注册表由明确的工具集合创建，同一集合同时决定模型能看见和程序能准备哪些调用。", "注册表查找工具并校验参数；需要批准的动作在你同意后才执行。", "读文件先定位再分页；写文件与命令分别按具体动作请求批准。"],
        "boundary": "拒绝会作为结果交回模型，不会自动结束本轮；shell 的人工批准也不等于沙箱隔离。",
        "notes": ["implemented/architecture/2026-08-31-tool-registry-boundary.md", "implemented/feature/2026-09-02-action-approval-scope.md", "implemented/feature/2026-09-05-bounded-file-retrieval.md", "implemented/bug-fix/2026-09-06-shared-read-guards.md", "implemented/bug-fix/2026-09-06-shell-interruption-reporting.md"],
        "sources": [{ "label": "turn.ts · handleCall", "path": "../src/turn.ts" }, { "label": "tools/registry.ts · 能力集合", "path": "../src/tools/registry.ts" }, { "label": "tools/index.ts · 主注册表", "path": "../src/tools/index.ts" }, { "label": "approval.ts · 批准", "path": "../src/approval.ts" }]
      },
      {
        "id": "result", "title": "结果回填", "caption": "成功、拒绝、错误都回填",
        "behavior": ["每次工具调用都配上相同 ID 的结果；过长的结果先截断，再写入历史。", "提前结束时，同批剩余调用补上“未执行”；异常时回滚本轮对话消息。"],
        "boundary": "回滚消息不会撤销已经发生的文件写入、命令执行或待办变更。",
        "notes": ["implemented/bug-fix/2026-09-06-tool-result-history-recovery.md", "implemented/architecture/2026-09-05-bounded-conversation-context.md"],
        "sources": [{ "label": "turn.ts · 结果回填", "path": "../src/turn.ts" }, { "label": "context.ts · truncateToolResult", "path": "../src/context.ts" }]
      },
      {
        "id": "context", "title": "对话上下文", "caption": "按完整用户轮保留历史",
        "behavior": ["新请求前按真实用户轮裁剪旧历史；内部继续提示不会被误算成新的一轮。", "发送给模型时去掉本地的轮次标记，保留标准消息结构。"],
        "boundary": "固定轮数不能保证固定 token 上限；对话消息也不会跨进程恢复。",
        "notes": ["implemented/architecture/2026-09-05-bounded-conversation-context.md", "implemented/architecture/2026-09-11-user-turn-boundaries.md"],
        "sources": [{ "label": "context.ts · trimHistory", "path": "../src/context.ts" }]
      },
      {
        "id": "todos", "title": "待办计划", "caption": "JSON 保存，启动时恢复",
        "behavior": ["由 todo 模块维护运行中的状态，修改后写入项目内的 JSON 文件。", "启动时通过注册表恢复清单，再开始接收用户请求。"],
        "boundary": "清单只保存计划；暂停状态、任务归属和多进程写入协调尚未实现。",
        "notes": ["implemented/architecture/2026-09-06-todo-json-persistence.md", "implemented/architecture/2026-09-10-todo-state-ownership.md"],
        "sources": [{ "label": "tools/todo.ts · 待办状态", "path": "../src/tools/todo.ts" }]
      },
      {
        "id": "delegation", "title": "子 Agent 委派", "caption": "独立上下文，只读调查",
        "behavior": ["主 Agent 通过 delegate_task 同步提交一个明确子任务，结果作为普通工具观察回填。", "每次委派新建独立消息历史，只开放读取、搜索、计算和时间工具；执行进度以 [sub] 日志显示。", "最后一次子请求撤下全部工具，根据已有证据总结或说明缺口。"],
        "boundary": "当前不并行、不持久化、不共享 todo、不嵌套批准，也不能递归委派；只读上下文隔离不等于数据保密。",
        "notes": ["implemented/feature/2026-09-19-isolated-readonly-subagent.md", "implemented/architecture/2026-08-31-tool-registry-boundary.md"],
        "sources": [{ "label": "subagent.ts · 独立执行循环", "path": "../src/subagent.ts" }, { "label": "tools/delegate.ts · 委派入口", "path": "../src/tools/delegate.ts" }, { "label": "tools/registry.ts · 能力集合", "path": "../src/tools/registry.ts" }]
      },
      {
        "id": "ask", "title": "提问", "caption": "缺少必要信息",
        "behavior": ["使用同一个终端输入实例等待回答，回答作为工具结果交回模型。", "回答仍属于发起询问的这一轮，之后模型可以继续调用工具。"],
        "boundary": "提问本身不会结束这一轮；回答“不”之后是否暂停，仍由模型选择控制工具。",
        "notes": ["implemented/feature/2026-09-11-explicit-turn-exits.md", "implemented/architecture/2026-09-02-shared-terminal-input.md"],
        "sources": [{ "label": "tools/control.ts · ask_user", "path": "../src/tools/control.ts" }]
      },
      {
        "id": "finish", "title": "完成", "caption": "本次请求已完成",
        "behavior": ["工具带有结束标记；结果回填后，主循环停止本轮的后续执行。", "是否完成以本次请求为准；“只记录待办”不要求把清单里的任务全部执行。"],
        "boundary": "完成的判断依赖模型；结束这一轮后，程序仍等待新的输入。",
        "notes": ["implemented/feature/2026-09-11-explicit-turn-exits.md", "implemented/bug-fix/2026-09-06-tool-result-history-recovery.md"],
        "sources": [{ "label": "tools/control.ts · finish_task", "path": "../src/tools/control.ts" }]
      },
      {
        "id": "pause", "title": "暂停", "caption": "尚未完成",
        "behavior": ["pause_task 通过结束标记停止本轮，等待你给出新的指令。", "提示词要求旧任务在明确恢复后继续，暂停不会自动删除待办。"],
        "boundary": "暂停原因只保留在对话中；当前没有持久化的暂停状态或任务隔离。",
        "notes": ["implemented/feature/2026-09-11-explicit-turn-exits.md", "implemented/architecture/2026-09-06-todo-json-persistence.md"],
        "sources": [{ "label": "tools/control.ts · pause_task", "path": "../src/tools/control.ts" }]
      }
    ]
  },
  "brief": {
